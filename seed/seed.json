{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Hayward's Family Ice Cream",
    "description": "Flavors, banner and contact details for HaywardsFamilyIceCream.com",
    "author": "Hayward's Family Ice Cream"
  },
  "settings": {
    "title": "Hayward's Family Ice Cream",
    "timezone": "America/New_York"
  },
  "collections": [
    {
      "slug": "settings",
      "label": "Site settings",
      "labelSingular": "Site settings",
      "description": "One entry (\"site\") holding the homepage banner, social links and contact details.",
      "supports": [
        "drafts",
        "revisions"
      ],
      "routable": false,
      "titleField": "title",
      "fields": [
        {
          "slug": "title",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "slug": "banner",
          "label": "Banner (plain text, leave empty to hide)",
          "type": "string"
        },
        {
          "slug": "social",
          "label": "Social links",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "label",
                "label": "Label",
                "type": "string",
                "required": true
              },
              {
                "slug": "type",
                "label": "Type",
                "type": "select",
                "required": true,
                "options": [
                  "facebook"
                ]
              },
              {
                "slug": "url",
                "label": "URL",
                "type": "url",
                "required": true
              }
            ]
          }
        },
        {
          "slug": "contact",
          "label": "Contact details",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "label",
                "label": "Label",
                "type": "string",
                "required": true
              },
              {
                "slug": "type",
                "label": "Type",
                "type": "select",
                "required": true,
                "options": [
                  "phone",
                  "place",
                  "email"
                ]
              },
              {
                "slug": "url",
                "label": "Link URL",
                "type": "string",
                "required": true
              },
              {
                "slug": "value",
                "label": "Displayed value",
                "type": "string",
                "required": true
              }
            ]
          }
        }
      ]
    },
    {
      "slug": "categories",
      "label": "Flavor categories",
      "labelSingular": "Flavor category",
      "description": "Headings on the flavor list, shown in display order.",
      "supports": [
        "drafts",
        "revisions"
      ],
      "routable": false,
      "titleField": "name",
      "fields": [
        {
          "slug": "name",
          "label": "Name",
          "type": "string",
          "required": true,
          "indexed": true
        },
        {
          "slug": "sort_order",
          "label": "Display order",
          "type": "integer",
          "required": true,
          "indexed": true
        }
      ]
    },
    {
      "slug": "flavors",
      "label": "Flavors",
      "labelSingular": "Flavor",
      "supports": [
        "drafts",
        "revisions",
        "search"
      ],
      "routable": false,
      "titleField": "name",
      "fields": [
        {
          "slug": "name",
          "label": "Flavor name",
          "type": "string",
          "required": true,
          "searchable": true,
          "indexed": true
        },
        {
          "slug": "category",
          "label": "Category",
          "type": "select",
          "required": true,
          "indexed": true,
          "validation": {
            "options": [
              "Ice Cream",
              "Sherbet",
              "Yogurt",
              "Sorbet",
              "Vegan",
              "No Sugar Added"
            ]
          }
        },
        {
          "slug": "sort_order",
          "label": "Order within category",
          "type": "integer",
          "required": true,
          "indexed": true
        },
        {
          "slug": "allergens",
          "label": "Allergens (not shown on the site)",
          "type": "multiSelect",
          "validation": {
            "options": [
              "gluten",
              "nuts"
            ]
          }
        },
        {
          "slug": "half_gallon",
          "label": "Available in half gallons (not shown on the site)",
          "type": "boolean"
        }
      ]
    }
  ],
