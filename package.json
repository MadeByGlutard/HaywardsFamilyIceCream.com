    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "15.0.0-beta.6",
    "@astrojs/react": "^7.1.9",
    "@emdash-cms/auth": "1.6.0",
    "@emdash-cms/cloudflare": "^1.6.0",
    "astro": "^7.4.13",
    "emdash": "^1.6.0",
    "kysely": "0.29.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vite-plugin": "^2.0.0-rc.0",
    "@cloudflare/workers-types": "^5.20261123.1",
    "cf": "^1.0.0-rc.2",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
