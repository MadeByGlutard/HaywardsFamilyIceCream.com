---
// gallery.tsx: 4 polaroids, picked per day (see src/lib/gallery.ts).
import Container from './Container.astro';
import Divider from './Divider.astro';
import Picture from './Picture.astro';
import type { GalleryItem } from '../lib/gallery';

interface Props {
  photos: GalleryItem[];
}
const { photos } = Astro.props;
---

<div class="viewport-width gallery">
  <h1 style="text-align:center">Our Gallery</h1>
  <Divider color="#fff" />

  <Container style="max-width:1200px">
    <div class="gallery-grid">
      {
        photos.map(photo => (
          <div class="gallery-column">
            <figure class="polaroid" style={`transform:rotate(${photo.tilt}deg)`}>
              <Picture
                name={`gallery/${photo.id}`}
                widths={[160, 320, 640]}
                formats={['jpg', 'webp']}
                layout="constrained"
                width={photo.width}
                height={photo.height}
                sizes={`(min-width: ${photo.width}px) ${photo.width}px, 100vw`}
                alt=""
                color={photo.color}
              />
            </figure>
          </div>
        ))
      }
    </div>
  </Container>
</div>
