---
// flavors.tsx
import Container from './Container.astro';
import Divider from './Divider.astro';
import type { FlavorCategory } from '../lib/content';

interface Props {
  categories: FlavorCategory[];
}
const { categories } = Astro.props;
---

<div class="viewport-width flavors">
  <Container style="max-width:1024px">
    <h1 style="text-align:center">Flavors</h1>
    <Divider color="#aaa" />

    <div class="flavors-columns">
      {
        categories.map(({ category, flavors }) => (
          <div>
            <h2>{category}</h2>
            <ul>
              {flavors.map(({ name }) => (
                <li>{name}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Container>
</div>
