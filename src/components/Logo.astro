---
// Logo as gatsby-plugin-image StaticImage with placeholder="none".
import Picture from './Picture.astro';
import meta from '../lib/image-meta.json';

interface Props {
  width: number;
  widths: number[];
  style: string;
  loading?: 'eager' | 'lazy';
}
const { width, widths, style, loading = 'lazy' } = Astro.props;
const height = Math.round((width * meta.logo.height) / meta.logo.width);
---

<Picture
  name="logo"
  widths={widths}
  formats={['png', 'webp']}
  layout="constrained"
  width={width}
  height={height}
  sizes={`(min-width: ${width}px) ${width}px, 100vw`}
  alt="Hayward's Family"
  loading={loading}
  style={style}
/>
