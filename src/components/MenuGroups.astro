---
/** Menu categories as ruled lists: the item, then its options on the same line when they fit. */
import type { MenuCategory } from '../lib/catalog';
interface Props { categories: MenuCategory[] }
const { categories } = Astro.props;
---
{categories.map((category) => <section class="menu-group" id={category.slug}>
  <div class="section-rule"><h2 {...category.edit.name}>{category.name}</h2>{category.shared && <span class="flavor-count">{category.shared}</span>}</div>
  <ul class="menu-list" role="list">{category.items.map((item) => <li><span class="row-name" {...item.edit.name}>{item.data.name}</span>{item.data.options && item.data.options !== category.shared && <span class="row-options" {...item.edit.options}>{item.data.options}</span>}</li>)}</ul>
</section>)}
