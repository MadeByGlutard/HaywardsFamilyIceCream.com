---
// contact.tsx: three cards over the silhouette background. Icons are the
// react-icons Material Design paths (MdPhone, MdPlace, MdEmail) inlined.
import Container from './Container.astro';
import Divider from './Divider.astro';
import type { ContactDetail } from '../lib/content';

interface Props {
  contact: ContactDetail[];
}
const { contact } = Astro.props;

const icons: Record<string, string> = {
  phone:
    'M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z',
  place: 'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z',
  email:
    'M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z',
};
const silhouette = (format: string) =>
  [750, 1080, 1334].map(w => `/images/silhouette-${w}.${format} ${w}w`).join(',');
---

<div class="viewport-width contact">
  <div class="contact-background">
    <picture>
      <source type="image/webp" srcset={silhouette('webp')} sizes="100vw" />
      <img src="/images/silhouette-1334.png" srcset={silhouette('png')} sizes="100vw" alt="" decoding="async" loading="lazy" />
    </picture>
  </div>

  <Container>
    <h1 style="text-align:center">Contact Us</h1>
    <Divider color="#aaa" />

    <div class="contact-grid">
      {
        contact.map(({ type, label, url, value }) => (
          <div class="contact-column">
            <div class="contact-card">
              <div class="contact-icon">
                <svg
                  stroke="currentColor"
                  fill="currentColor"
                  stroke-width="0"
                  viewBox="0 0 24 24"
                  height="1em"
                  width="1em"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path fill="none" d="M0 0h24v24H0z" />
                  {icons[type] && <path d={icons[type]} />}
                </svg>
              </div>
              <strong class="contact-title">{label}</strong>
              <a href={url} class="contact-link">
                {value}
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</div>
