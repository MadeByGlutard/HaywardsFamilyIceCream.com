<!--
  Fade-in for <Picture> images, as gatsby-plugin-image does it: when a main
  image has loaded and decoded, show it and fade its placeholder out. The
  `js` class gates the initial opacity:0, so without JavaScript images show.
  Runs in <head>, before any image can finish loading.
-->
<script is:inline>
  (function () {
    document.documentElement.classList.add('js');
    function reveal(img) {
      var wrapper = img.closest('[data-image-wrapper]');
      var placeholder = wrapper && wrapper.querySelector('[data-placeholder-image]');
      var show = function () {
        img.style.opacity = 1;
        if (placeholder) placeholder.style.opacity = 0;
      };
      if (img.decode) img.decode().catch(function () {}).then(show);
      else show();
    }
    document.addEventListener(
      'load',
      function (event) {
        var target = event.target;
        if (target && target.hasAttribute && target.hasAttribute('data-main-image')) reveal(target);
      },
      true,
    );
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('img[data-main-image]').forEach(function (img) {
        if (img.complete && img.naturalWidth) reveal(img);
      });
    });
  })();
</script>
