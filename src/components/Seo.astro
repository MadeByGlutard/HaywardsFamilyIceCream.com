---
// seo.tsx: same title/description/Open Graph/Twitter tags.
import { SITE_DESCRIPTION, SITE_TITLE } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
}
const title = [Astro.props.title, SITE_TITLE].filter(Boolean).join(' | ');
const description = Astro.props.description ?? SITE_DESCRIPTION;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
