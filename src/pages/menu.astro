---
import { getEmDashCollection } from 'emdash';
import MenuNote from '../components/MenuNote.astro';
import Base from '../layouts/Base.astro';
import { photos } from '../lib/photos';
import { getScheduleContext } from '../lib/schedule';
import { menuGroups } from '../lib/menu';
import { categoryId, categoryLabel, getCategories, getLocation, isNamedFlavor, sameCategory, telephone } from '../lib/site';
import { cacheContentPage } from '../lib/cache';
cacheContentPage(Astro);
const [categories, { entries: allFlavors }, groups, { data: place }] = await Promise.all([getCategories(), getEmDashCollection('flavors', { orderBy: { name: 'asc' }, limit: 200 }), menuGroups('/menu'), getLocation()]);
const flavors = allFlavors.filter((flavor) => isNamedFlavor(flavor.data.name));
// S’mores sorts as "smores".
const byName = [...flavors].sort((a, b) => a.data.name.localeCompare(b.data.name, 'en', { ignorePunctuation: true }));
const closed = (await getScheduleContext(Astro, place)).openState === 'closed';
const [main, ...rest] = categories.map((category) => ({ category, id: categoryId(category), label: categoryLabel(category), flavors: byName.filter((f) => sameCategory(f.data.category, category)) }));
const items = (heading: string) => groups.find((group) => group.heading === heading)?.items ?? [];
// Scoop sizes read as one line; anything with its own sizes (soft serve) follows.
const sizes = items('Sizes');
const scoops = items('Sizes').filter((item) => !item.data.options);
const others = items('Sizes').filter((item) => item.data.options);
---
<Base title="Ice cream flavors" description="Hayward’s Milford ice cream flavors, frozen yogurt, sherbet, sorbet, vegan and no-sugar-added options, with sizes and cones.">
  <section class="page-heading wrap"><h1>Flavors</h1><MenuNote lead="Flavors come and go." /></section>
  {sizes.length > 0 && <div class="size-lines wrap">
    <p><strong>Sizes</strong> {scoops.map((item, i) => <>{i > 0 && ', '}<span {...item.edit.title}>{i > 0 ? item.data.title.toLowerCase() : item.data.title}</span></>)}.{others.map((item) => <>{' '}<span {...item.edit.title}>{item.data.title}</span>: <span {...item.edit.options}>{item.data.options!.toLowerCase()}</span>.</>)}</p>
    <p class="size-links">{!closed && <a href={telephone(place.phone)}>Ask about sizes: {place.phone}</a>}<a href="/menu/sundaes">Frappes and sundaes</a></p>
  </div>}
  <div class="menu-layout wrap">
    <div class="flavor-main">
      <section id={main.id}>
        <div class="section-rule"><h2>{main.label}</h2></div>
        <ul class="flavor-list" role="list">{main.flavors.map((flavor) => <li><span class="row-name" {...flavor.edit.name}>{flavor.data.name.replace(/'/g, '’')}</span>{flavor.data.description && <p {...flavor.edit.description}>{flavor.data.description}</p>}{flavor.data.allergen_notes && <small>{flavor.data.allergen_notes}</small>}</li>)}</ul>
      </section>
      <div class="flavor-extra">{items('Cones and toppings').map((item) => <section>
        <div class="section-rule"><h2 {...item.edit.title}>{item.data.title}</h2></div>
        <p {...item.edit.options}>{item.data.options}</p>
      </section>)}</div>
    </div>
    <div class="flavor-side">
      {rest.map((group) => <section id={group.id}>
        <div class="section-rule"><h2>{group.label}</h2></div>
        {group.flavors.length > 0
          ? <ul class="flavor-list" role="list">{group.flavors.map((flavor) => <li><span class="row-name" {...flavor.edit.name}>{flavor.data.name.replace(/'/g, '’')}</span>{flavor.data.description && <p {...flavor.edit.description}>{flavor.data.description}</p>}{flavor.data.allergen_notes && <small>{flavor.data.allergen_notes}</small>}</li>)}</ul>
          : <p>Changes often. Ask at the window.</p>}
      </section>)}
      <figure class="menu-photo"><img src={photos.twoCups.src} alt={photos.twoCups.alt} srcset={photos.twoCups.srcset} sizes="(max-width: 740px) 100vw, 400px" width={photos.twoCups.width} height={photos.twoCups.height} style={`object-position: ${photos.twoCups.position}`} loading="lazy" /></figure>
    </div>
  </div>
</Base>
