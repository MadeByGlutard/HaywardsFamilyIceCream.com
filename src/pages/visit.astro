---
import Base from '../layouts/Base.astro';
import {getLocation,telephone} from '../lib/site';
import {daysBetween,getScheduleContext,datesLabel,effectiveEnd,isStaleClosure,publicTitle} from '../lib/schedule';
import {photoSets} from '../lib/photos';
import {withPlaceholders,withSentences} from '../lib/text';
import { cacheContentPage } from '../lib/cache';
cacheContentPage(Astro);
const location=await getLocation();const place=location.data;
const schedule=await getScheduleContext(Astro,place);
const status=schedule.status;
const statusEdit=status.source==='period'?status.edit:location.edit[status.source];
const photo=photoSets[schedule.photoSet];
// A period can replace the Visit introduction (e.g. while closed); empty falls back to Visit information.
const periodIntro=schedule.active?.data.visit_intro?.trim();
const intro=periodIntro?{text:periodIntro,edit:schedule.active!.edit.visit_intro}:{text:place.intro,edit:location.edit.intro};
const closed=schedule.openState==='closed';
// Coming up: dated periods that start within 45 days.
const showNote=!!place.hours_note&&status.line===place.hours;
const upcoming=schedule.periods.filter(s=>!isStaleClosure(s,schedule.today)).filter(s=>s!==schedule.active&&!!s.start&&(effectiveEnd(s,schedule.periods)??'9999-12-31')>=schedule.today).filter(s=>s.start!<=schedule.today||daysBetween(schedule.today,s.start!)<=45).slice(0,3);
// Nobody has updated the hours in a while: the header says to call, this page says what's usual.
const usual=status.source==='notice'&&status.line!==place.notice?.trim();
---
<Base title="Hours & directions" description={`${place.hours}. ${place.hours_note ?? ''} Hayward’s Family Ice Cream, ${place.address}, ${place.locality}. ${place.phone}.`.replace(/\s+/g, ' ')} image={photo.visit.src}>
  <section class="page-heading wrap"><h1>Hours &amp; directions</h1><p {...intro.edit}>{intro.text}</p></section>
  <div class={`visit-layout wrap photo-set-${schedule.photoSet}`}>
    <section class="visit-hours"><p class="eyebrow">Hours</p><h2 {...statusEdit} set:html={withSentences(status.line)} />{showNote && <p {...location.edit.hours_note}>{place.hours_note}</p>}{schedule.treesOpen && /\bfrom \d/i.test(status.line) && <p><a class="text-link" href={telephone(place.phone)}>Call for closing time</a></p>}{upcoming.length>0 && <div class="coming-up"><h3>Coming up</h3><ul role="list">{upcoming.map(s=><li><strong {...(s.data.dates_label?s.edit.dates_label:s.edit.start_date)} set:html={withPlaceholders(datesLabel(s))} />{' '}{s.data.show_trees_nav ? <a href="/trees">{publicTitle(s.data.title)}</a> : <span {...s.edit.title}>{publicTitle(s.data.title)}</span>}{s.data.status_text && <span class="coming-hours" {...s.edit.status_text}>{s.data.status_text}</span>}</li>)}</ul></div>}{usual && <p>Usually {place.hours.charAt(0).toLowerCase()+place.hours.slice(1)}.</p>}</section>
    <section class="visit-place"><p class="eyebrow">Find us</p><h2 {...location.edit.address}>{place.address}</h2><p {...location.edit.locality}>{place.locality}</p><a class="button" href={place.directions}>Get directions <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></section>
    <section class="visit-contact"><p class="eyebrow">Call or write</p><h2><a href={telephone(place.phone)}>{place.phone}</a></h2><p class="stack-links">{place.email && <a class="text-link" href={`mailto:${place.email}`}>{place.email}</a>}<span class="column-links">{place.facebook && <a class="text-link" href={place.facebook}>Facebook</a>}{place.instagram && <a class="text-link" href={place.instagram}>Instagram</a>}</span></p></section>
    <figure><div class="crop"><img src={photo.visit.src} alt={photo.visit.alt} srcset={'srcset' in photo.visit ? photo.visit.srcset : undefined} sizes="(max-width: 1000px) 100vw, 900px" width={photo.visit.width} height={photo.visit.height} /></div></figure>
  </div>
</Base>
