---
import Base from '../layouts/Base.astro';
import {getLocation,getPage,telephone} from '../lib/site';
import {getScheduleContext} from '../lib/schedule';
import {photoSets} from '../lib/photos';
import {withSentences} from '../lib/text';
import { cacheContentPage } from '../lib/cache';
cacheContentPage(Astro);
const [page,location]=await Promise.all([getPage('visit'),getLocation()]);
if(!page)return Astro.rewrite('/404');
const place=location.data;
const schedule=await getScheduleContext(Astro);
const status=schedule.status;
const statusEdit=status.edit;
// The period's photo is still the page's share image; on the page itself, a map.
const photo=photoSets[schedule.photoSet];
// Google's keyless embed: a pin on the stand, Google Maps a tap away. Loads only when scrolled to.
const mapUrl=`https://www.google.com/maps?q=${encodeURIComponent(`Hayward’s Family Ice Cream, ${place.address}, ${place.locality}`)}&z=15&output=embed`;
---
<Base title="Hours & directions" description={`${status.line}. Hayward’s Family Ice Cream, ${place.address}, ${place.locality}. ${place.phone}.`.replace(/\s+/g, ' ')} image={photo.visit.src}>
  <section class="page-heading wrap"><h1 {...page.headlineEdit}>{page.headline}</h1>{page.data.excerpt && <p {...page.edit.excerpt}>{page.data.excerpt}</p>}</section>
  <div class="visit-layout wrap">
    <section class="visit-hours"><p class="eyebrow">Hours</p><h2 {...statusEdit} set:html={withSentences(status.line)} />{schedule.treesOpen && /\bfrom \d/i.test(status.line) && <p><a class="text-link" href={telephone(place.phone)}>Call for closing time</a></p>}</section>
    <section class="visit-place"><p class="eyebrow">Find us</p><h2 {...location.edit.address}>{place.address}</h2><p {...location.edit.locality}>{place.locality}</p><a class="button" href={place.directions}>Get directions <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></section>
    <section class="visit-contact"><p class="eyebrow">Call or write</p><h2><a href={telephone(place.phone)}>{place.phone}</a></h2><p class="stack-links">{place.email && <a class="text-link" href={`mailto:${place.email}`}>{place.email}</a>}<span class="column-links">{place.facebook && <a class="text-link" href={place.facebook}>Facebook</a>}{place.instagram && <a class="text-link" href={place.instagram}>Instagram</a>}</span></p></section>
    <figure class="visit-map"><div class="crop"><iframe src={mapUrl} title={`Map of ${place.address}, ${place.locality}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div></figure>
  </div>
</Base>
