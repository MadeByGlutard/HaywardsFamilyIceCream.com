---
import { getEmDashEntry, getSeoMeta } from 'emdash';
import { PortableText } from 'emdash/ui';
import EndBand from '../components/EndBand.astro';
import Base from '../layouts/Base.astro';
import { cacheContentPage } from '../lib/cache';
cacheContentPage(Astro);
const {entry:story}=await getEmDashEntry('pages','our-story');
if(!story)return Astro.rewrite('/404');
const seo=getSeoMeta(story,{defaultTitle:'Our story',defaultDescription:story.data.excerpt});
---
<Base title={seo.title} description={seo.description || story.data.excerpt} content={{collection:'pages',id:story.data.id,slug:'our-story'}}>
  <section class="page-heading story-heading wrap"><p class="eyebrow" {...story.edit.eyebrow}>{story.data.eyebrow}</p><h1 {...story.edit.title}>{story.data.title.replace(/Elm Street/g, 'Elm\u00a0Street')}</h1><p {...story.edit.excerpt}>{story.data.excerpt}</p></section>
  <figure class="story-banner wrap"><img src="/images/milford-stand.jpg" alt="Hayward’s Family Ice Cream on Elm Street in Milford" width="720" height="480" /><figcaption>The familiar stand on Elm Street. A present-day view, with a story that reaches back into Milford’s dairy history.</figcaption></figure>
  <article class="story-body wrap"><div class="story-prose" {...story.edit.content}><PortableText value={story.data.content || []} /></div></article>
  <section class="sources wrap" id="sources"><details><summary>History notes & sources <i class="ph ph-plus" aria-hidden="true"></i></summary><p>This story draws on local histories, reporting and an original school yearbook. The precise opening year is recorded differently across sources, so we have left it undated here.</p><ol>
    <li><a href="https://milfordhistory.online/haywards-milford-nh">Matt Bowling, “Hayward’s Ice Cream” — Milford History Online</a></li>
    <li><a href="https://www.cabinet.com/news/merrimack-news/2016/04/02/milford-8217s-milk-man/">“Milford’s milk man” — The Cabinet, 2016</a></li>
    <li><a href="https://www.cardcow.com/346802/hayward-farms-ice-cream-stand-milford-new-hampshire/">Hayward Farms postcard — historical front and back</a></li>
    <li><a href="https://milfordhistory.com/wp-content/uploads/Milford%20High%20School%20Yearbook%201948%20(searchable).pdf#page=50">Milford High School yearbook, 1948 — Hayward Farms advertisement, PDF page 50</a></li>
    <li><a href="https://www.collaborativenh.org/granite-solutions-coronavirus-1/2022/6/22/these-seacoast-stops-are-on-nh-ice-cream-trail-states-greatest-summer-adventure">Granite State News Collaborative — 2022 Ice Cream Trail reporting</a></li>
  </ol></details></section>
  <EndBand headline="Make your own memories." label="Come visit" url="/visit" />
</Base>
