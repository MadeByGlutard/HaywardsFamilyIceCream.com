---
import { getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import { pageSeo, photoUrl } from '../../lib/site';
import Base from '../../layouts/Base.astro';
import PostByline from '../../components/PostByline.astro';
import { cacheContentPage } from '../../lib/cache';
cacheContentPage(Astro);
const { entry: post } = await getEmDashEntry('posts', Astro.params.slug!);
if (!post) return Astro.rewrite('/404');
const photo = post.data.photo?.src ? post.data.photo : undefined;
---
<Base {...pageSeo(post, { title: post.data.title, description: post.data.excerpt, image: photoUrl(post.data.photo) })} content={{ collection: 'posts', id: post.data.id, slug: post.id }}>
  <section class="page-heading story-heading wrap">
    <p class="eyebrow"><a href="/blog">Blog</a></p>
    <h1 {...post.edit.title}>{post.data.title}</h1>
    {post.data.excerpt && <p {...post.edit.excerpt}>{post.data.excerpt}</p>}
    <PostByline byline={post.data.byline} date={post.data.publishedAt} />
  </section>
  {photo && <figure class="story-banner post-photo wrap" {...post.edit.photo}><img src={photo.src} alt={photo.alt ?? ''} width={photo.width} height={photo.height} /></figure>}
  <article class="story-body wrap"><div class="story-prose post-prose" {...post.edit.content}><PortableText value={post.data.content || []} /></div></article>
  {!!post.data.sources?.length && <section class="sources wrap" id="sources"><details><summary>Sources <i class="ph ph-plus" aria-hidden="true"></i></summary><div class="sources-list" {...post.edit.sources}><PortableText value={post.data.sources} /></div></details></section>}
  <p class="post-end wrap"><a class="text-link" href="/blog">All posts</a></p>
</Base>
