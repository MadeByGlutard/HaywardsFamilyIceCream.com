---
import { getEmDashCollection, getMenu } from 'emdash';
import { milfordDay } from '../lib/schedule';
// Design review: one page in every published schedule period, side by side at a chosen width.
// Dev server, preview builds (behind Cloudflare Access) and signed-in EmDash staff; 404 for everyone else.
if (!import.meta.env.DEV && !__ACCESS_SIGN_IN__ && !Astro.locals.user) return new Response(null, { status: 404 });
// Every page in Main navigation, in its order (Trees included in every period).
const menu = await getMenu('primary');
const pages = (menu?.items ?? []).map((item) => [item.url === '/home' ? '/' : item.url, item.label] as const);
// Every published period from the one in force now onward (earlier ones come round again after),
// then ones with no first day yet.
const { entries } = await getEmDashCollection('schedule', { limit: 200 });
const today = milfordDay(new Date())!;
const dated = entries.flatMap((e) => { const day = milfordDay(e.data.start_date); return day ? [{ e, day }] : []; })
  .sort((a, b) => a.day.localeCompare(b.day) || a.e.id.localeCompare(b.e.id));
const now = Math.max(0, dated.findLastIndex((p) => p.day <= today));
const periods = [...dated.slice(now), ...dated.slice(0, now), ...entries.filter((e) => !milfordDay(e.data.start_date)).map((e) => ({ e, day: '' }))]
  .map(({ e, day }) => [e.id, `${e.data.title}${day ? '' : ' (no start date yet)'}`] as const);
const widths = [['390', 'Phone'], ['820', 'iPad'], ['1440', 'Desktop']] as const;
const q = Astro.url.searchParams;
const page = pages.find(([p]) => p === q.get('page'))?.[0] ?? '/';
const width = widths.find(([w]) => w === q.get('width'))?.[0] ?? '390';
const link = (patch: Record<string, string>) => `?${new URLSearchParams({ page, width, ...patch })}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><title>Design preview</title>
  <style>
    body { margin: 0; background: #f3f2ef; color: #1f1e1c; font: 14px/1.4 system-ui, sans-serif; }
    header { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; padding: 14px 16px; border-bottom: 1px solid #d8d5ce; }
    h1 { font-size: 16px; margin: 0; } nav { display: flex; gap: 14px; } a { color: inherit; } a[aria-current] { font-weight: 700; text-decoration: none; }
    main { display: flex; gap: 20px; padding: 16px; overflow-x: auto; } figure { margin: 0; flex: none; } figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px; font-weight: 600; padding-bottom: 8px; }
    .open { flex: none; font-weight: 500; } .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .frame { width: calc(var(--w) * var(--s) * 1px); height: calc(900px * var(--s)); overflow: hidden; border: 1px solid #d8d5ce; background: #fff; }
    iframe { width: calc(var(--w) * 1px); height: 900px; border: 0; transform: scale(var(--s)); transform-origin: 0 0; }
  </style>
</head>
<body>
  <header><h1>Design preview</h1><nav aria-label="Page">{pages.map(([p, l]) => <a href={link({ page: p })} aria-current={p === page ? 'true' : undefined}>{l}</a>)}</nav><nav aria-label="Width">{widths.map(([w, l]) => <a href={link({ width: w })} aria-current={w === width ? 'true' : undefined}>{l}</a>)}</nav></header>
  <main>{periods.map(([slug, label]) => <figure><figcaption><span>{label}</span><a class="open" href={`${page}?period=${slug}`} target="_blank" rel="noopener">Open full page<span class="sr"> in a new tab: {label}</span></a></figcaption><div class="frame" style={`--w:${width};--s:${width === '390' ? 1 : width === '820' ? .6 : .4}`}><iframe title={label} src={`${page}?period=${slug}`} loading="lazy"></iframe></div></figure>)}</main>
</body>
</html>
