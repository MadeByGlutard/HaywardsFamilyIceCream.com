---
import { getEmDashCollection, getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import EndBand from '../components/EndBand.astro';
import Base from '../layouts/Base.astro';
import { getLocation, telephone } from '../lib/site';
import { getScheduleContext } from '../lib/schedule';
import { photos } from '../lib/photos';
import { sentence } from '../lib/status';
import { sharedOptions } from '../lib/menu';
import { withPlaceholders } from '../lib/text';
import { cacheContentPage } from '../lib/cache';
cacheContentPage(Astro);

const [{ entry: page }, { entries: products }, location] = await Promise.all([
  getEmDashEntry('pages', 'trees'),
  getEmDashCollection('products', { orderBy: { sort_order: 'asc' }, limit: 200 }),
  getLocation(),
]);
const schedule = await getScheduleContext(Astro, location.data);

// Section order and headings (design); the items themselves are EmDash content.
const sections = [
  { category: 'Tree', heading: 'Christmas trees', id: 'trees' },
  { category: 'Wreath', heading: 'Wreaths', id: 'wreaths' },
  { category: 'Kissing ball', heading: 'Kissing balls', id: 'kissing-balls' },
  { category: 'Extra', heading: 'Extras', id: 'extras' },
].map((s) => ({ ...s, items: products.filter((p) => p.data.category?.toLowerCase() === s.category.toLowerCase()) }))
 .map((s) => ({ ...s, shared: sharedOptions(s.items.map((item) => item.data.options)) }))
 .filter((s) => s.items.length > 0);

const title = page?.data.title ?? 'Christmas trees & wreaths';
const opens = schedule.nextTrees?.start
  ? new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', weekday: 'long', month: 'long', day: 'numeric' }).format(new Date(`${schedule.nextTrees.start}T12:00:00Z`))
  : undefined;
// The heading answers "are the trees in yet?"; the page's own title is the line above it.
const answer = schedule.treesOpen ? 'Trees are on the lot' : opens && schedule.treesNav ? `Trees arrive ${opens}` : undefined;
// Today's hours while open, the lot's own hours before it opens.
const lot = schedule.treesOpen ? schedule.status.line : schedule.nextTrees?.data.status_text?.trim();
const hoursLine = lot && sentence(lot);
const askClosing = schedule.treesOpen && !!lot && /\bfrom \d/i.test(lot);
const gallery = [
  { ...photos.wreathWall, caption: 'Wreaths along the windows.' },
  { ...photos.kissingBalls, caption: 'Kissing balls with velvet ribbon.' },
  { ...photos.wreathCloseup, caption: 'Bows, ornaments and gold pinecones.' },
];
---
<Base title={title} description="Christmas trees, 24-inch wreaths and kissing balls at Hayward’s on Elm Street in Milford, from Thanksgiving weekend until just before Christmas." content={page ? { collection: 'pages', id: page.data.id, slug: 'trees' } : undefined} image={photos.treesStorefront.src} strip={!schedule.treesOpen}>
  <section class="page-heading wrap">
    {answer
      ? <><p class="eyebrow" {...page?.edit.title}>{title.replace(/\.$/, '')}</p><h1>{answer}</h1></>
      : <><p class="eyebrow" {...page?.edit.eyebrow} set:html={withPlaceholders(schedule.endedTrees ? 'Until next year' : page?.data.eyebrow)} /><h1 {...page?.edit.title}>{title.replace(/\.$/, '')}</h1></>}
    {schedule.treesListed
      ? null
      : schedule.endedTrees
      ? <p>The lot is closed for the year. Thank you, Milford. Trees and wreaths usually arrive Thanksgiving weekend.</p>
      : <p>Trees and wreaths are at the stand each year from Thanksgiving weekend until just before Christmas. {!opens && 'We’ll post the next opening day here and on Facebook.'}</p>}
    {schedule.treesListed && <div class="trees-note" {...page?.edit.content}><p>{hoursLine && <span set:html={withPlaceholders(hoursLine)} />} At the stand until just before Christmas.</p>{page?.data.content?.length ? <PortableText value={page.data.content} /> : <p>Prices are marked at the lot.</p>}</div>}
    {askClosing && <p class="trees-call"><a class="text-link" href={telephone(location.data.phone)}>Call for closing time</a></p>}
  </section>

  {schedule.treesListed && sections.length > 0 && (
    <div class="trees-layout wrap">
      <figure class="trees-lead"><div class="crop"><img src={photos.treesStorefront.src} alt={photos.treesStorefront.alt} srcset={photos.treesStorefront.srcset} sizes="(max-width: 1000px) 100vw, 400px" width={photos.treesStorefront.width} height={photos.treesStorefront.height} fetchpriority="high" /></div><figcaption>At the stand, {location.data.address}.</figcaption></figure>
      <div class="trees-list">
        {sections.map((s) => (
          <section class="trees-group" id={s.id}>
            <div class="section-rule"><h2>{s.heading}</h2>{s.shared && <span class="flavor-count" set:html={withPlaceholders(s.shared)} />}</div>
            <ul class="menu-list" role="list">{s.items.map((item) => (
              <li><span class="row-name" {...item.edit.title}>{item.data.title}</span>{item.data.options && item.data.options !== s.shared && <span class="row-options" {...item.edit.options} set:html={withPlaceholders(item.data.options)} />}</li>
            ))}</ul>
          </section>
        ))}
      </div>
    </div>
  )}

  <section class="photo-row wrap" aria-label="Photos from the tree lot">
    {gallery.map((photo) => <figure><div class="crop"><img src={photo.src} alt={photo.alt} srcset={photo.srcset} sizes="(max-width: 740px) 50vw, 400px" width={photo.width} height={photo.height} loading="lazy" /></div><figcaption>{photo.caption}</figcaption></figure>)}
  </section>

  {schedule.treesOpen
    ? <EndBand headline="Come pick out your tree." label="Get directions" url={location.data.directions ?? '/visit'} />
    : schedule.treesListed
    ? <EndBand headline="See you at the lot." label="Hours & directions" url="/visit" />
    : <EndBand headline="Find us on Elm Street." label="Hours & directions" url="/visit" />}
</Base>
