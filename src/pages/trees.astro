---
import { PortableText } from 'emdash/ui';
import EndBand from '../components/EndBand.astro';
import Base from '../layouts/Base.astro';
import { endBand, getLocation, getPage, telephone } from '../lib/site';
import { getScheduleContext } from '../lib/schedule';
import { photos } from '../lib/photos';
import { sentence } from '../lib/status';
import MenuGroups from '../components/MenuGroups.astro';
import { menuCategories } from '../lib/catalog';
import { withPlaceholders } from '../lib/text';
import { cacheContentPage } from '../lib/cache';
cacheContentPage(Astro);

const [page, all, location] = await Promise.all([
  getPage('trees'),
  menuCategories('trees'),
  getLocation(),
]);
if (!page) return Astro.rewrite('/404');
const categories = all.filter((category) => category.items.length > 0);
const schedule = await getScheduleContext(Astro);

const title = page.headline;
const opens = schedule.nextTrees?.start
  ? new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', weekday: 'long', month: 'long', day: 'numeric' }).format(new Date(`${schedule.nextTrees.start}T12:00:00Z`))
  : undefined;
// The heading answers "are the trees in yet?"; the page's own title is the line above it.
const answer = schedule.treesOpen ? 'Trees are on the lot' : opens && schedule.treesNav ? `Trees arrive ${opens}` : undefined;
// Today's hours while open, the lot's own hours before it opens.
const lot = schedule.treesOpen ? schedule.status.line : schedule.nextTrees?.data.status_text?.trim();
const hoursLine = lot && sentence(lot);
const askClosing = schedule.treesOpen && !!lot && /\bfrom \d/i.test(lot);
const lead = photos.treesOnRacks;
// While the lot is open the page ends on its own band; otherwise on Hours & directions'.
const band = await endBand(schedule.treesOpen ? page : undefined);
// The photos speak for themselves: alt text, no captions.
const gallery = [
  photos.porch,
  photos.wreathsDusk,
  photos.treesNetted,
  photos.bows,
  photos.pinecone,
  photos.snowmen,
];
---
<Base title={title} description={page.data.summary || page.data.excerpt} content={{ collection: 'site_pages', id: page.data.id, slug: 'trees' }} image={lead.src} strip={!schedule.treesOpen}>
  <section class="page-heading wrap">
    {answer
      ? <><p class="eyebrow" {...page.headlineEdit}>{title.replace(/\.$/, '')}</p><h1>{answer}</h1></>
      : <><p class="eyebrow" >{schedule.endedTrees ? 'Until next year' : 'Every holiday season'}</p><h1 {...page.headlineEdit}>{title.replace(/\.$/, '')}</h1></>}
    {schedule.treesListed
      ? null
      : schedule.endedTrees
      ? <p {...page.edit.after_season}>{page.data.after_season}</p>
      : <p {...page.edit.excerpt}>{page.data.excerpt}</p>}
    {schedule.treesListed && <div class="trees-note" {...page.edit.content}><p>{hoursLine && <span set:html={withPlaceholders(hoursLine)} />} At the stand until just before Christmas.</p>{page.data.content?.length ? <PortableText value={page.data.content} /> : <p>Prices are marked at the lot.</p>}</div>}
    {askClosing && <p class="trees-call"><a class="text-link" href={telephone(location.data.phone)}>Call for closing time</a></p>}
  </section>

  {schedule.treesListed && categories.length > 0 && (
    <div class="trees-layout wrap">
      <figure class="trees-lead"><div class="crop"><img src={lead.src} alt={lead.alt} srcset={lead.srcset} sizes="(max-width: 1000px) 100vw, 400px" width={lead.width} height={lead.height} style={`object-position: ${lead.position}`} fetchpriority="high" /></div></figure>
      <div class="trees-list">
        <MenuGroups categories={categories} />
      </div>
    </div>
  )}

  <section class="photo-row wrap" aria-label="Photos from the tree lot">
    {gallery.map((photo) => <figure><div class="crop"><img src={photo.src} alt={photo.alt} srcset={photo.srcset} sizes="(max-width: 740px) 50vw, 400px" width={photo.width} height={photo.height} style={photo.position ? `object-position: ${photo.position}` : undefined} loading="lazy" /></div></figure>)}
  </section>

  {band && <EndBand {...band} />}
</Base>
