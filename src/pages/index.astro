---
// pages/index.tsx
import Contact from '../components/Contact.astro';
import Flavors from '../components/Flavors.astro';
import Gallery from '../components/Gallery.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import { cachePage, secondsUntilMidnight } from '../lib/cache';
import { getFlavorCategories, getSettings } from '../lib/content';
import { pickGallery } from '../lib/gallery';

const [settings, { categories, cacheHints }] = await Promise.all([getSettings(), getFlavorCategories()]);
const photos = pickGallery();

// Purged on publish via EmDash's cache tags; expires at New York midnight at
// the latest, when the gallery pick changes.
cachePage(Astro.cache, Astro.response.headers, [settings.cacheHint, ...cacheHints], secondsUntilMidnight());
---

<Layout isHomepage={true} settings={settings}>
  <Header />

  {settings.banner && <div class="viewport-width banner">{settings.banner}</div>}

  <Flavors categories={categories} />

  <Gallery photos={photos} />

  <Contact contact={settings.contact} />
</Layout>
