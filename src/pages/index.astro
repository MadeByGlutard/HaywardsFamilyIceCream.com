---
// pages/index.tsx
import Contact from '../components/Contact.astro';
import Flavors from '../components/Flavors.astro';
import Gallery from '../components/Gallery.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import { PUBLIC_CACHE_CONTROL } from '../lib/cache';
import { getFlavorCategories, getSettings } from '../lib/content';
import { pickGallery } from '../lib/gallery';

const [settings, categories] = await Promise.all([getSettings(), getFlavorCategories()]);
const photos = pickGallery();

Astro.response.headers.set('Cache-Control', PUBLIC_CACHE_CONTROL);
---

<Layout isHomepage={true} settings={settings}>
  <Header />

  {settings.banner && <div class="viewport-width banner">{settings.banner}</div>}

  <Flavors categories={categories} />

  <Gallery photos={photos} />

  <Contact contact={settings.contact} />
</Layout>
