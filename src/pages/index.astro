---
import EndBand from '../components/EndBand.astro';
import Base from '../layouts/Base.astro';
import { endBand, fillSummary, getLocation, getPage, photoList, photoUrl, pageSeo } from '../lib/site';
import { menuCategories } from '../lib/catalog';
import { getScheduleContext } from '../lib/schedule';
import Photo from '../components/Photo.astro';
import { withPlaceholders } from '../lib/text';
import { cacheContentPage } from '../lib/cache';
cacheContentPage(Astro);
const [page, categories, location, ...columns] = await Promise.all([getPage('home'), menuCategories('flavors'), getLocation(), getPage('flavors'), getPage('sundaes'), getPage('food')]);
const band = await endBand(page);
// The Flavors menu's first category of flavors (ice cream) gives the count in its summary.
const iceCream = categories.find((category) => category.flavors.length)?.flavors ?? [];
const place = location.data;
const schedule = await getScheduleContext(Astro);
const active = schedule.active;
const { hero_headline: headline, hero_deck: deck } = active.data;
// The period's home page photos (the tree lot's also while closed just before it), else the Home page's.
const periodPhotos = photoList(active.data.photos).length ? photoList(active.data.photos)
  : schedule.photoSet === 'trees' ? photoList(schedule.nextTrees?.data.photos) : [];
const photos = periodPhotos.length ? periodPhotos : photoList(page?.data.photos);
const closed = schedule.closed;
// Closed with the tree lot coming next (e.g. Thanksgiving): point the hero at /trees, not the ice cream menu.
const treesNext = closed && !!schedule.nextTrees;
// The hero's main action follows the period: trees while the lot is open or coming,
// Facebook while closed (that's where reopening news goes). Otherwise the menu links below are the action.
const primary = schedule.treesOpen ? { label: 'See trees & wreaths', url: '/trees' }
  : treesNext ? { label: 'See what’s coming', url: '/trees' }
  : closed && place.facebook ? { label: 'Get updates on Facebook', url: place.facebook }
  : undefined;
// Before the lot opens (and the hero isn't already about it), say when the trees come.
const treesDate = !closed && !schedule.treesOpen && schedule.treesNav && schedule.nextTrees?.start
  ? new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', weekday: 'long', month: 'long', day: 'numeric' }).format(new Date(`${schedule.nextTrees.start}T12:00:00Z`))
  : undefined;
const primaryExternal = !!primary && /^https?:/.test(primary.url);
---
<Base {...pageSeo(page, { title: 'Homemade ice cream', description: page?.data.summary, image: photoUrl(photos[0]) })} content={page && { collection: 'site_pages', id: page.data.id, slug: 'home' }}>
  <section class="home-intro wrap">{!schedule.status.strip && page?.data.excerpt && <p class="eyebrow" {...page.edit.excerpt}>{page.data.excerpt}</p>}<h1 {...active.edit.hero_headline}>{headline.split('\n').map((line) => <><span class="line" set:html={withPlaceholders(line)} />{' '}</>)}</h1><p class="intro-deck" {...active.edit.hero_deck} set:html={withPlaceholders(deck)} />
    {primary && <div class="actions"><a class="button" href={primary.url}>{primary.label} <i class={`ph ${primaryExternal ? 'ph-arrow-up-right' : 'ph-arrow-right'}`} aria-hidden="true"></i></a></div>}</section>
  {treesDate && <section class="trees-line wrap"><h2><a href="/trees">Trees arrive {treesDate} <i class="ph ph-arrow-right" aria-hidden="true"></i></a></h2></section>}
  <section class="news-columns wrap" aria-label="The menu">
    {columns.map((column) => column && <article><h2><a href={`/${column.id}`}>{column.data.title} <i class="ph ph-arrow-right" aria-hidden="true"></i></a></h2><p {...column.edit.summary}>{fillSummary(column.data.summary, { flavors: iceCream.length })}</p></article>)}
  </section>
  <div class={`photo-spread wrap photo-set-${schedule.photoSet}`}>
    {photos.map((photo, i) => <div class="crop"><Photo image={photo} sizes={i === 0 ? '(max-width: 740px) 100vw, 820px' : '(max-width: 740px) 1px, 620px'} priority={i === 0} /></div>)}
  </div>
  {band && <EndBand {...band} />}
</Base>
