---
import { getEmDashCollection } from 'emdash';
import { PortableText } from 'emdash/ui';
import Base from '../layouts/Base.astro';
import { getLocation, getPage, photoUrl, telephone } from '../lib/site';
import Photo from '../components/Photo.astro';
import { cacheContentPage } from '../lib/cache';
cacheContentPage(Astro);
const [page, { entries }, { data: place }] = await Promise.all([getPage('jobs'), getEmDashCollection('jobs', { orderBy: { name: 'asc' }, limit: 50 }), getLocation()]);
if (!page) return Astro.rewrite('/404');
// Open positions first, then A to Z.
const jobs = [...entries].sort((a, b) => Number(!!b.data.hiring) - Number(!!a.data.hiring));
const photo = page.data.photo;
// The page's text: its heading and first paragraph go above the Call and Email buttons, the rest below.
const blocks: any[] = page.data.content ?? [];
const split = blocks.findIndex((block) => block.style === 'normal') + 1;
const intro = blocks.slice(0, split);
const rules = blocks.slice(split);
---
<Base title={page.data.title} description={page.data.summary || page.data.excerpt || undefined} content={{ collection: 'site_pages', id: page.data.id, slug: 'jobs' }} image={photoUrl(photo)}>
  <section class="page-heading wrap"><h1 {...page.headlineEdit}>{page.headline}</h1>{page.data.excerpt && <p {...page.edit.excerpt}>{page.data.excerpt}</p>}</section>
  {jobs.length > 0 && <section class="job-list wrap" aria-label="Positions">
    {jobs.map((job) => <article>
      {job.data.hiring && <p class="eyebrow job-hiring">Hiring now</p>}
      <h2 {...job.edit.name}>{job.data.name}</h2>
      <p {...job.edit.description}>{job.data.description}</p>
    </article>)}
  </section>}
  <section class="job-apply wrap">
    <div class="job-apply-text">
      {intro.length > 0 && <div {...page.edit.content}><PortableText value={intro} /></div>}
      <p class="job-actions"><a class="button" href={telephone(place.phone)}><i class="ph ph-phone" aria-hidden="true"></i>Call {place.phone}</a>{place.email && <a class="button button-line" href={`mailto:${place.email}?subject=${encodeURIComponent('Working at Hayward’s')}`}><i class="ph ph-envelope-simple" aria-hidden="true"></i>Email us</a>}</p>
      {rules.length > 0 && <div class="job-rules"><PortableText value={rules} /></div>}
    </div>
    {photo && <figure class="job-photo"><Photo image={photo} sizes="(max-width: 739px) 100vw, 448px" /></figure>}
  </section>
</Base>
