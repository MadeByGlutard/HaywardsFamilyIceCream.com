---
// EmDash's Live View for non-routable entries points to collection/slug.
// Those entries are shown together on their public landing pages.
const { collection, slug } = Astro.params;
if (collection === 'jobs') return Astro.redirect('/jobs', 302);
if (collection === 'store') return Astro.redirect('/visit', 302);
if (collection === 'catalog_flavors') return Astro.redirect('/flavors', 302);
if (collection === 'catalog_items' || collection === 'catalog_categories') return Astro.redirect('/food', 302);
// Live View of a period previews it on the home page (honoured for signed-in staff).
if (collection === 'schedule' && slug) return Astro.redirect(`/?period=${encodeURIComponent(slug)}`, 302);
return Astro.rewrite('/404');
---
