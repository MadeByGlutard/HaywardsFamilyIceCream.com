---
import { getEmDashCollection, getMenu, getSiteSettings } from 'emdash';
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from 'emdash/ui';
import { createPublicPageContext } from 'emdash/page';
import { getLocation, telephone } from '../lib/site';
import { getScheduleContext } from '../lib/schedule';
import { withPlaceholders, withSentences } from '../lib/text';
// opsz: Fraunces with its optical-size axis (the default file has weight only).
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/dm-sans';
// Newsreader italic sets the site's italic lines (tagline, kickers, footer labels).
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@phosphor-icons/web/regular';
import '../styles/theme.css';
interface Props { title: string; strip?: boolean; description?: string; content?: { collection: string; id: string; slug?: string | null }; image?: string; /** From the SEO panel: "noindex, nofollow" hides the page from search engines. */ robots?: string; }
const { strip: showStripProp = true, title, content, robots } = Astro.props;
const [settings, menu, location, { entries: sitePages }] = await Promise.all([getSiteSettings(), getMenu('primary'), getLocation(), getEmDashCollection('site_pages', { limit: 100 })]);
const place = location.data;
// A page without its own description or share image uses the site's tagline and default share image (Settings).
const description = Astro.props.description || settings.tagline || undefined;
const image = Astro.props.image || (settings.seo?.defaultOgImage as any)?.url || undefined;
// "Milford, NH 03055" in Store info, split for search engines.
const [, town = place.locality, region, postalCode] = place.locality.match(/^(.+?),\s*([A-Z]{2})\s+(\d{5}(?:-\d{4})?)$/) ?? [];
const schedule = await getScheduleContext(Astro);
const status = schedule.status;
const preview = schedule.preview;
// "We'll post our reopening day on Facebook": the notice links there.
const linkSocial = (html: string) => [['Facebook', place.facebook], ['Instagram', place.instagram]].reduce((out, [name, url]) => (url ? out!.replace(new RegExp(`\\b${name}\\b`), `<a href="${url}">${name}</a>`) : out), html);
const statusEdit = status.edit;
const siteTitle = settings.title || 'Hayward’s Family Ice Cream';
const fullTitle = `${title} | ${siteTitle} · Milford, NH`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const page = createPublicPageContext({ Astro, kind: content ? 'content' : 'custom', pageType: 'website', title: fullTitle, description, canonical, image: image ? new URL(image, Astro.site).href : undefined, content, siteName: siteTitle, ...(robots ? { seo: { robots } } : {}) });
const structured = { '@context':'https://schema.org', '@type':'IceCreamShop', name:siteTitle, url:Astro.site?.href, telephone:telephone(place.phone).slice(4), ...(image ? { image: new URL(image, Astro.site).href } : {}), address:{'@type':'PostalAddress',streetAddress:place.address,addressLocality:town,...(region ? { addressRegion: region } : {}),...(postalCode ? { postalCode } : {}),addressCountry:'US'}, sameAs:[place.facebook, place.instagram].filter(Boolean) };

// Main navigation in Menus links to entries in Pages. Every one is in the footer; the top menu
// (and the phone Menu) has only the pages ticked "Show in the top menu". Trees & wreaths shows
// in the periods ticked "Show Trees & wreaths in the menu".
const promoted = new Set(sitePages.filter((entry) => entry.data.top_menu).map((entry) => entry.id));
const navItems = (menu?.items ?? [])
  .map((item) => ({ label: item.label, url: item.url === '/home' ? '/' : item.url, top: promoted.has(item.url.replace(/^\//, '').split('/')[0]) }))
  .filter((item) => item.url !== '/trees' || schedule.treesNav);
const topItems = navItems.filter((item) => item.top);
const showStrip = showStripProp && !!status.strip;
const stripHtml = linkSocial(withSentences(status.strip));
const themeColor = schedule.accent === 'green' ? '#2e5a3c' : '#a71d2a';
---
<!doctype html>
<html lang="en" data-accent={schedule.accent}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content={themeColor} />
    <title>{fullTitle}</title><link rel="icon" href="/favicon.ico" sizes="48x48" /><link rel="icon" href="/brand/icons/favicon-32.png" type="image/png" sizes="32x32" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /><link rel="manifest" href="/site.webmanifest" crossorigin="use-credentials" />
    {preview && <meta name="robots" content="noindex" />}
    {/* Previews: show EmDash's on-page Edit button without a visit to the admin. Access signs them in on the first click. */}
    {__ACCESS_SIGN_IN__ && <script is:inline>try { localStorage.setItem('emdash-editor', '1'); } catch (e) {}</script>}
    <EmDashHead page={page} />
    <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <EmDashBodyStart page={page} /><a class="skip-link" href="#main">Skip to content</a>
    {preview && <p class="preview-flag" role="note">Preview: {schedule.active.data.title} · {schedule.today}</p>}
    {showStrip && <aside class="notice-strip" aria-label="Notice"><p class="wrap" {...status.stripEdit} set:html={schedule.treesOpen ? `<a href="/trees">${stripHtml}</a>` : stripHtml} /></aside>}
    <header class="site-header">
      <div class="masthead wrap">
        <p class="masthead-note"><span>Milford, New Hampshire</span><em>A little taste of home.</em></p>
        <a class="menu-button" href="#pages" aria-haspopup="dialog"><i class="ph ph-list" aria-hidden="true"></i>Menu</a>
        <a class="brand" href="/" aria-label="Hayward’s Family Ice Cream, home"><img src="/brand/logo.png" alt="Hayward’s Family Ice Cream" width="768" height="216" /></a>
        <p class="masthead-contact"><a href={place.directions}>{place.address}<span class="sr-only">, directions</span></a><a href={telephone(place.phone)}>{place.phone}</a></p>
        <a class="call-link" href={telephone(place.phone)} aria-label={`Call ${place.phone}`}><i class="ph ph-phone" aria-hidden="true"></i>Call</a>
      </div>
      <div class="nav-bar"><div class="nav-wrap wrap">
        <nav class="main-nav" aria-label="Main navigation">{topItems.map(item => <a href={item.url} aria-current={path === item.url ? 'page' : undefined}>{item.label}</a>)}</nav>
        <div class="status-row"><span class="opening-cell"><a class="opening" href="/visit"><span class="status-text" {...statusEdit} set:html={withSentences(status.line)} /><span class="status-alt">Hours &amp; directions</span><span class="sr-only">, hours and directions</span></a></span><a class="directions-link" href={place.directions}><i class="ph ph-map-pin" aria-hidden="true"></i><span>{place.address}</span><span class="sr-only">, directions</span></a></div>
      </div></div>
    </header>
    {/* The Menu button's dialog on phones and tablets. Without script, Menu jumps to the page list in the footer. */}
    <dialog class="menu-sheet" id="site-menu" aria-label="Menu"><div class="menu-panel">
      <div class="menu-top"><button class="menu-button" type="button" data-close><i class="ph ph-x" aria-hidden="true"></i>Close</button></div>
      <nav aria-label="Pages">{topItems.map(item => <a href={item.url} aria-current={path === item.url ? 'page' : undefined}>{item.label}</a>)}</nav>
      <p class="menu-actions"><a class="button" href={place.directions}><i class="ph ph-map-pin" aria-hidden="true"></i>Directions</a><a class="button button-line" href={telephone(place.phone)}><i class="ph ph-phone" aria-hidden="true"></i>Call</a></p>
    </div></dialog>
    <main id="main"><slot /></main>
    <footer class="footer wrap">
      <nav class="footer-col footer-menu" id="pages" aria-label="All pages"><h2>Pages</h2>{navItems.filter(item => item.url !== '/').map(item => <a href={item.url}>{item.label}</a>)}</nav>
      <div class="footer-col"><h2>Find us</h2><p>{place.address}<br />{place.locality}</p><a href={place.directions}>Get directions</a></div>
      <div class="footer-col"><h2>Hours &amp; contact</h2><p set:html={withSentences(status.line)} /><a href={telephone(place.phone)}>{place.phone}</a><p class="footer-links">{place.facebook && <a href={place.facebook}>Facebook</a>}{place.instagram && <a href={place.instagram}>Instagram</a>}{place.email && <a href={`mailto:${place.email}`}>Email</a>}</p></div>
      <div class="footer-fine"><span>© {new Date().getFullYear()} Hayward’s Family Ice Cream</span><a href="/admin">Login</a></div>
    </footer>
    <script>
      import '../scripts/menu';
      // A link to #sources opens the sources it links to.
      const openTarget = () => document.getElementById(location.hash.slice(1))?.querySelector('details')?.setAttribute('open', '');
      addEventListener('hashchange', openTarget);
      openTarget();
    </script>
    {preview && <script is:inline>
      // Design review: keep ?period= / ?today= when following internal links.
      (function () {
        var keep = new URLSearchParams();
        new URLSearchParams(location.search).forEach(function (v, k) { if (k === 'period' || k === 'today') keep.set(k, v); });
        document.querySelectorAll('a[href^="/"]:not([href^="/_emdash"])').forEach(function (a) {
          var url = new URL(a.getAttribute('href'), location.origin);
          keep.forEach(function (v, k) { if (!url.searchParams.has(k)) url.searchParams.set(k, v); });
          a.setAttribute('href', url.pathname + url.search + url.hash);
        });
      })();
    </script>}
    <EmDashBodyEnd page={page} />
  </body>
</html>
