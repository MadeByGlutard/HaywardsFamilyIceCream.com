---
import { MAX_LENGTH, MIN_LENGTH } from "../hash";
---

<label>
	New password (at least {MIN_LENGTH} characters)
	<input name="password" type="password" autocomplete="new-password" minlength={MIN_LENGTH} maxlength={MAX_LENGTH} required />
</label>
<label>
	Repeat it
	<input name="confirm" type="password" autocomplete="new-password" minlength={MIN_LENGTH} maxlength={MAX_LENGTH} required />
</label>
